# Ajustá usuario, contraseña y nombre de base a tu PostgreSQL local.

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/proyecto_grado_db
DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# CORS: con DEBUG=True se permiten por defecto localhost en puertos típicos del front
# (3000, 5173, 4200). Para otro origen o puerto, listá URLs separadas por coma:
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Opcional: WFS Montevideo (defaults = servicios mapstore-tematicas)
# WFS_PARCELAS_URL=https://montevideo.gub.uy/app/geoserver/mapstore-tematicas/ic_v_mdg_parcelas_geom_limite/ows
# WFS_PARCELAS_LAYER=mapstore-tematicas:ic_v_mdg_parcelas_geom_limite
# WFS_BARRIOS_URL=https://montevideo.gub.uy/app/geoserver/mapstore-tematicas/zon_v_sig_municipios/ows
# WFS_BARRIOS_LAYER=mapstore-tematicas:zon_v_sig_municipios

# Debug: valor no vacío habilita el form field force_fail en validate-zoning / BCF.
# BCF_FORCE_FAIL_ENABLED=1
